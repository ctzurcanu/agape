# Browser configuration, copied from Allways into .env.local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend / migration credentials belong in .env.server.local only.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=<legacy service-role key, if needed>
# DATABASE_URL=<postgres connection string>
# Never prefix backend credentials with VITE_.
